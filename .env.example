# Database (SQLite — relative to prisma directory)
DATABASE_URL=file:./db/custom.db

# JWT Authentication (REQUIRED — generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# NextAuth (if using NextAuth — currently unused, kept for future)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Optional: Company branding override
# NEXT_PUBLIC_COMPANY_NAME=ConnectZ Sales & Services
